[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Mfg%
CatalogFile=tegra214pep.cat
DriverVer=11/14/2026,0.2.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
tegra214pep.sys=1

[Manufacturer]
%Mfg%=Models,NTarm64

[Models.NTarm64]
%Device%=Install,ACPI\SWOA0E01

[Install.NT]
CopyFiles=Files

[Files]
tegra214pep.sys

[Install.NT.Services]
AddService=tegra214pep,0x2,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=0
ErrorControl=1
ServiceBinary=%12%\tegra214pep.sys
LoadOrderGroup=Core Platform Extensions
AddReg=Service_Params

[Service_Params]
HKR,"Parameters","EnableSc7",0x00010003,0

[Strings]
Mfg="SwitchWOA"
Disk="Switch Lite T214 PoFx power extension"
Device="Tegra T214 processor and SC7 power extension"
